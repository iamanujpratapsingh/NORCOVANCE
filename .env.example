# Database — use PostgreSQL connection string on Render
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Server
PORT=4000
CLIENT_ORIGIN=https://your-render-service.onrender.com

# Frontend build environment: point the React client to the deployed API.
# VITE_API_URL=https://your-api-service.onrender.com/api

# Gemini AI (backend only — never expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# RSA signing keys for tamper-evident records
# On Render: paste the PEM content as a single line with \n for newlines
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=
